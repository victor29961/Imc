<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:vm="clr-namespace:Imc.Maui.ViewsModels"
             x:Class="Imc.Maui.Views.MainPage"
             Title="MainPage">

    <ContentPage.BindingContext>
        <vm:MainViewsModel/>
    </ContentPage.BindingContext>



<VerticalStackLayout
        Padding="24"
        Spacing="24">
        <Border>
            <VerticalStackLayout
                Padding="18"
                Spacing="8">
                <Label
                    Text="Proporcione el peso en kilogramos"/>
                <Entry
                    Text="{Binding Path=Peso}"
                    BackgroundColor="Black"
                    
                    Keyboard="Numeric"/>
                <Label
                    Text="proporcione la estatura en metros"/>
                <Entry
                    Text="{Binding Path=Estatura}"
                    
                    BackgroundColor= "Black"
                    
                    Keyboard="Numeric"/>
            </VerticalStackLayout>
        </Border>

        <HorizontalStackLayout
            Spacing="24"
            HorizontalOptions="Center">
            <Button
                Text="Calcular"
                Background="Green"
                TextColor="White"
                Command="{Binding Path=CalcularCommand}"
                />

            <Button
                  BackgroundColor="Gray"
                TextColor="White"
                 Text="Limpiar"
                 Command="{Binding Path=LimpiarCommand}"
                />
        </HorizontalStackLayout>

        <Border>
            <VerticalStackLayout
                Padding="18"
                Spacing="8">
                <Label
                    Text="El indice demasa corporal de la persona es"/>
                <Label
                    Text="{Binding Path=Imc}"
                    HorizontalOptions="Center"
                    FontSize="Medium"
                    FontAttributes="Bold"/>
                
                <Label
                    Text="El estado nutricional de la persona es"/>
                <Label
                    Text="{Binding Path=EstadoNutricional}"
                    HorizontalOptions="Center"
                    FontSize="Medium"
                    FontAttributes="Bold"/>
            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>
</ContentPage>